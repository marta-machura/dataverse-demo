<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Dataverse runs plugins on .NET Framework, so 4.6.2 is required. -->
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Roster.Plugins</RootNamespace>
    <!-- Dataverse only accepts strong-name signed plugin assemblies. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Roster.Plugins.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.60" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
